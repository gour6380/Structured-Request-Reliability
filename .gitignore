# Local datasets, frozen weights, generated runs and private preservation receipts.
/data/
/models/
/checkpoints/
/artifacts/
/runs/
/outputs/
/benchmarks/results/
/verification/

# Publish reviewed prose and explicitly curated, sanitized evidence only.
/reports/*
!/reports/technical-report.md
!/reports/public/
/reports/public/*
!/reports/public/results.json
!/reports/public/reference-scores.png

# Publish only the reviewed output-free notebook. Working notebooks, backups and
# new exports stay local until reviewed and explicitly allowed here.
*.ipynb
/notebooks/*
!/notebooks/public/
/notebooks/public/*
!/notebooks/public/structured_request_reliability.ipynb

# Secrets and large binary payloads remain excluded even inside public folders.
.env
.env.*
!.env.example
!.env.template
.envrc
.netrc
.pypirc
