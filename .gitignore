# Local Python environments, caches, build output and editor state.
.venv/
venv/
env/
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.coverage
.coverage.*
htmlcov/
.DS_Store
*.log
.ipynb_checkpoints/
.jupyter/
.ipython/
.vscode/
